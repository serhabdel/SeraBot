{
  "schemaVersion": 2,
  "slug": "notion",
  "name": "Notion",
  "tagline": "Read and update pages in Notion.",
  "description": "Search your workspace, read pages and add content in Notion. Sign in with your own account in the browser; the tokens are sealed for you alone. Writes ask for approval.",
  "category": "productivity",
  "iconUrl": "https://www.notion.com/favicon.ico",
  "version": "1.1.0",
  "minServerVersion": "0.51.0",
  "prompts": [
    {
      "id": "notion-0",
      "text": "Find my meeting notes from last week."
    }
  ],
  "apps": [
    {
      "id": "workspace",
      "name": "Workspace",
      "server": {
        "transport": "http",
        "url": "https://mcp.notion.com/mcp"
      },
      "auth": [
        {
          "id": "signin",
          "kind": "oauth",
          "fields": [],
          "oauth": {
            "scopes": [],
            "usesCimd": true
          }
        }
      ],
      "tools": {
        "readOnly": [
          "notion-search",
          "notion-fetch",
          "notion-get-comments",
          "notion-get-users",
          "notion-get-teams"
        ]
      },
      "accounts": {
        "multiple": false
      }
    }
  ],
  "permissions": {
    "egress": [
      "mcp.notion.com"
    ]
  },
  "websiteUrl": "https://www.notion.com",
  "privacyPolicyUrl": "https://www.notion.com/privacy",
  "termsUrl": "https://www.notion.com/terms"
}
