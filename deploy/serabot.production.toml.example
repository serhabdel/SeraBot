# Production example for /etc/serabot/serabot.toml on the OVH VPS.
# Create users/directories and secrets only after an approved additive installation.
# The API stays on loopback; terminate TLS in the existing reverse proxy/tunnel.

[server]
bind = "127.0.0.1:8787"
body_limit_bytes = 2097152
request_timeout_secs = 30
rate_limit_per_minute = 60
event_retention_days = 30
allow_non_loopback = false

[database]
path = "/var/lib/serabot/serabot.db"
max_connections = 4
busy_timeout_ms = 5000

[secrets]
encrypted_file = "/etc/serabot/private/secrets.age"
identity_file = "/etc/serabot/private/age-identity.txt"

[api]
enabled = true
# printf '%s' "$TOKEN" | serabot --config /etc/serabot/serabot.toml hash-token
token_hash = "REPLACE_WITH_64_HEX_CHARACTERS"
approval_expiry_hours = 24

[telegram]
enabled = false
bot_token_secret = "telegram_bot_token"
owner_user_id = 0
owner_chat_id = 0
poll_timeout_secs = 25

[llm]
base_url = "https://api.mistral.ai/v1"
model = "mistral-large-latest"
api_key_secret = "llm_api_key"
timeout_secs = 120
max_tool_rounds = 6
max_output_tokens = 4096
data_egress_approved = false
# Extra allowed models for the reserved "default" provider (no network discovery).
models = []
# Optional synthetic profile: requires its encrypted key at startup.
# Consent must be explicitly approved independently of conversation selection.
# [llm.providers.secondary]
# base_url = "https://api.example.com/v1"
# api_key_secret = "secondary_llm_key"
# models = ["example-model"]
# data_egress_approved = false

[embeddings]
model = "multilingual-e5-small"
dimension = 384
cache_dir = "/var/lib/serabot/models"
batch_size = 16

[policy]
blocklist_file = "/etc/serabot/private/blocklist.txt"
notify_owner_on_violation = true

[watcher]
sources_file = "/etc/serabot/config/sources.toml"
user_agent = "SeraBot/0.1 (personal research agent)"
timeout_secs = 30
max_response_bytes = 5242880
morning_brief_enabled = true

[onedrive]
enabled = false
graph_base = "https://graph.microsoft.com/v1.0"
tenant = "common"
client_id_secret = "onedrive_client_id"
refresh_token_secret = "onedrive_refresh_token"
folder = "SeraBot"
conflict_behavior = "rename"

[firecrawl]
enabled = false
api_base = "https://api.firecrawl.dev"
api_key_secret = "firecrawl_api_key"
timeout_secs = 120
max_markdown_chars = 80000
max_map_links = 500
max_map_limit = 500
max_search_limit = 10
max_crawl_limit = 25
crawl_poll_interval_ms = 2000
crawl_max_wait_secs = 300

[render]
brand_file = "/etc/serabot/config/brand.toml"
artifacts_dir = "/var/lib/serabot/artifacts"
max_pages = 30

[runtime]
max_concurrent_turns = 2
max_tool_calls_per_turn = 8
max_tool_iterations = 6
task_lease_secs = 300
worker_poll_ms = 500
history_limit = 30
owner_standing_consent = false

[schedule]
tick_secs = 30
timezone = "Europe/Rome"
brief_time = "08:00"
source_stagger_secs = 20
watch_times = ["07:45", "13:00", "18:00"]

[documents]
watch_dir = "/var/lib/serabot/inbox"
max_bytes = 52428800
chunk_chars = 1200
chunk_overlap = 150
retrieval_k = 8

[audio]
enabled = false
provider = "default"
transcription_model = "voxtral-mini-latest"
understanding_model = "voxtral-small-latest"
max_bytes = 52428800
telegram_intake = false
telegram_max_bytes = 20971520
