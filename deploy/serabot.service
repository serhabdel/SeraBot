[Unit]
Description=SeraBot single-operator agent
Documentation=file:///opt/serabot/serabot.toml
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=serabot
Group=serabot
WorkingDirectory=/var/lib/serabot
ExecStart=/opt/serabot/serabot --config /etc/serabot/serabot.toml run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
Environment=RUST_LOG=serabot=info,tower_http=warn

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Chrome's sandbox for the server browser needs user, pid, net and mount
# namespaces; every other namespace type stays blocked.
RestrictNamespaces=user pid net mnt
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

ReadWritePaths=/var/lib/serabot
ReadOnlyPaths=/opt/serabot /etc/serabot

# Headroom for headless Chrome sessions ([browser] max_sessions = 2).
MemoryMax=2200M
CPUQuota=180%
TasksMax=512

[Install]
WantedBy=multi-user.target
